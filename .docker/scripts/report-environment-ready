#!/bin/sh

set -eu

wait_for_php_fpm() {
	attempt=0
	while [ "$attempt" -lt 100 ]; do
		if php -r '
			$socket = @fsockopen("127.0.0.1", 9000, $errno, $errstr, 0.1);
			if ($socket === false) {
				exit(1);
			}
			fclose($socket);
		' >/dev/null 2>&1; then
			return 0
		fi
		attempt=$((attempt + 1))
		sleep 0.1
	done
	return 1
}

emit_banner() {
	{
	printf '\n'
	printf '┌─ 💙 Environment ready ───────────────────────────\n'
	printf '│\n'
	[ -z "${ENV_NEXTCLOUD_URL:-}" ] || printf '│ %-15s %s\n' 'Nextcloud' "$ENV_NEXTCLOUD_URL"
	[ -z "${ENV_MAILPIT_URL:-}" ] || printf '│ %-15s %s\n' 'Mailpit' "$ENV_MAILPIT_URL"
	[ -z "${ENV_EUROOFFICE_URL:-}" ] || printf '│ %-15s %s\n' 'EuroOffice' "$ENV_EUROOFFICE_URL"
	[ -z "${ENV_PLAYWRIGHT_URL:-}" ] || printf '│ %-15s %s\n' 'Playwright' "$ENV_PLAYWRIGHT_URL"
	[ -z "${ENV_SIGNAL_URL:-}" ] || printf '│ %-15s %s\n' 'Signal' "$ENV_SIGNAL_URL"
	printf '│\n'
	[ -z "${ENV_NEXTCLOUD_BRANCH:-}" ] || printf '│ %-16s %s\n' 'Nextcloud branch' "$ENV_NEXTCLOUD_BRANCH"
	[ -z "${ENV_ADMIN_USER:-}" ] || printf '│ %-16s %s\n' 'Admin user' "$ENV_ADMIN_USER"
	[ -z "${ENV_ADMIN_PASSWORD:-}" ] || printf '│ %-16s %s\n' 'Admin password' "$ENV_ADMIN_PASSWORD"
	printf '│\n'
	printf '│ 🔐 HTTPS uses the LibreCode local development CA.\n'
	printf '│    Trust it once if your browser shows a warning.\n'
	printf '│\n'
	printf '└──────────────────────────────────────────────────\n'
	} > /proc/1/fd/2
}

if ! wait_for_php_fpm; then
	echo 'Could not confirm PHP-FPM readiness; skipping environment banner.' >&2
	exit 0
fi

emit_banner
